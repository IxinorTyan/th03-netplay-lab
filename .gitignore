# Upload only the ready-to-run distribution. Development files remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-RELAY.md
!/README-PUBLIC.md
!/web/
!/server.py
!/lan_server.py
!/relay_server.py
!/turn_service.py
!/public_tunnel.py
!/configure_turn.py
!/requirements-relay.txt
!/start.bat
!/start-lan.bat
!/start-public-tunnel.bat
!/install-relay.bat
!/configure-turn.bat

# The web directory contains the complete runtime distribution.
# TH03 stores its two language images under web/disks/.
!/web/disks/
!/web/vendor/

# Development-only material is not part of the downloadable package.
/tools/
/patches/
/reports/
/build/
/DEVELOPMENT.md
/web/baseline/
/web/build/
/web/extracted/
/web/reports/
/web/screenshots/
/web/tools/
/web/vendor-source/

# Local credentials, tunnel URLs and generated diagnostics stay private.
turn-config.local.json
public-test-url.txt
*.log

# Common caches, editor files and temporary artifacts.
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
*.bak
*.orig
*~
.idea/
.vscode/
.env
.env.*
